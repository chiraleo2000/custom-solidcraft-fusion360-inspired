{
  "id": "pdf_day26_mesh_edit",
  "day": 26,
  "title": "Mesh tools smoke",
  "smoke": true,
  "description": "Insert mesh, plane cut, remesh, reduce, repair, shell. STL stem names the mesh body.",
  "commands": [
    {
      "command": "solid.box",
      "params": { "length": 20, "width": 16, "height": 12, "body_name": "Stock" }
    },
    {
      "command": "file.save_mesh",
      "params": { "path": "${tmp}/Edit.stl", "bodies": ["Stock"] }
    },
    {
      "command": "file.insert_mesh",
      "params": { "path": "${tmp}/Edit.stl", "name": "Edit" }
    },
    {
      "command": "mesh.plane_cut",
      "params": {
        "body": "Edit",
        "origin": [10, 8, 6],
        "normal": [0, 0, 1],
        "keep": [10, 8, 9]
      }
    },
    {
      "command": "mesh.remesh",
      "params": { "body": "Edit", "target": 200 }
    },
    {
      "command": "mesh.reduce",
      "params": { "body": "Edit", "ratio": "0.5" }
    },
    {
      "command": "mesh.repair",
      "params": { "body": "Edit" }
    },
    {
      "command": "mesh.shell",
      "params": { "body": "Edit", "thickness": "1 mm" }
    },
    {
      "command": "inspect.measure",
      "params": {}
    }
  ]
}
