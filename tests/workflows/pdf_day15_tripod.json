{
  "id": "pdf_day15_tripod",
  "day": 15,
  "title": "Painter's tripod tip",
  "description": "Loft a rectangular base to a point (pyramid), then shell.",
  "smoke": false,
  "commands": [
    {
      "command": "sketch.create",
      "params": {
        "plane": "XY",
        "name": "Bottom"
      }
    },
    {
      "command": "sketch.rectangle.two_point",
      "params": {
        "p0": [-8, -4],
        "p1": [8, 4]
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": {
          "origin": [0, 0, 50],
          "x_dir": [1, 0, 0],
          "y_dir": [0, 1, 0]
        },
        "name": "Apex"
      }
    },
    {
      "command": "sketch.point",
      "params": {
        "point": [0, 0]
      },
      "bind": {
        "apex": "point"
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.loft",
      "params": {
        "sections": [
          {
            "sketch": "Bottom"
          },
          {
            "sketch": "Apex",
            "point": "${apex}"
          }
        ],
        "body_name": "Pyramid",
        "operation": "new"
      }
    },
    {
      "command": "solid.shell",
      "params": {
        "faces": [[0, 0, 0]],
        "thickness": "1.5 mm",
        "body": "Pyramid"
      }
    },
    {
      "command": "inspect.measure",
      "params": {}
    }
  ]
}
